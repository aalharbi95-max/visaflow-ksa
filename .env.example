# Configure these separately for each Vercel Production, Preview, or Staging environment.
# Never commit real keys. Browser code must use a publishable key, never a service-role credential.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=

# Standalone Housing Supabase project used only by /housing.
VITE_HOUSING_SUPABASE_URL=
VITE_HOUSING_SUPABASE_PUBLISHABLE_KEY=
